{
  "name": "muabankey",
  "version": "1.0.0",
  "private": true,
  "description": "MuaBanKey - Nền tảng mua bán bản quyền số tự động trên Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute muabankey-db --remote --file=./db/schema.sql",
    "db:export": "wrangler d1 export muabankey-db --remote --output=backups/backup.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
