{
  "name": "muabankey",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "MuaBanKey - Nền tảng mua bán bản quyền số tự động trên Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "node scripts/migrate-remote.mjs",
    "db:migrate:check": "node db/migrate.mjs --check", 
    "db:migrate:local": "node db/migrate.mjs --sqlite .wrangler/local-muabankey.sqlite" ,
    "db:export": "wrangler d1 export muabankey-db --remote --output=backups/backup.sql",
    "tail": "wrangler tail",
    "test": "node test/run.mjs",
    "test:watch": "node --watch test/run.mjs",
    "verify": "node test/run.mjs && node scripts/check-syntax.mjs && python test/app-coordinator.test.py",
    "clean:css": "node scripts/clean-css.mjs",
    "clean:css:media": "node scripts/clean-css-media.mjs",
    "audit:license-days": "node scripts/audit-license-days.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
